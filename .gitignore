# 环境变量与密钥（含微信读书登录凭证，切勿提交）
.env
.env.local

# Python 缓存与字节码
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# 虚拟环境
.venv/
venv/
env/

# 编辑器 / IDE
.idea/
.vscode/
*.swp

# 日志
*.log

# 抓取失败标记（CI 运行时生成）
feeds/.fetch_failed

# 分析器临时输入（WorkBuddy 自动化兜底 / 手动重放时产生，勿入版本库）
.erniao_*.txt
.erniao_*.json
*.article.txt

# 本地 AI / 编辑器状态
.workbuddy/
